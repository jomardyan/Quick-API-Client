{
  "name": "quick-api-client",
  "version": "1.3.0",
  "description": "Test REST/GraphQL APIs from a browser extension popup",
  "private": true,
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "lint": "eslint .",
    "test:browser": "node scripts/browser-smoke.js",
    "test:browser:source": "node scripts/browser-smoke.js --source",
    "assets:generate": "node generate-screenshots.js",
    "assets:check": "node scripts/generate-store-assets.js --check",
    "test:dependencies": "node scripts/test-dependency-compat.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "eslint": "^10.14.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.1",
    "jest-webextension-mock": "^4.2.0",
    "playwright": "^1.55.1",
    "sharp": "^0.35.5",
    "@eslint/js": "^10.0.1",
    "globals": "^17.0.0",
    "glob-modern": "npm:glob@^14.0.3",
    "minimatch-modern": "npm:minimatch@^11.0.4"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFiles": [
      "jest-webextension-mock"
    ],
    "transform": {},
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/tests/"
    ]
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "overrides": {
    "deepmerge": "file:./scripts/dependency-compat/deepmerge",
    "minimatch": "file:./scripts/dependency-compat/minimatch",
    "glob": "file:./scripts/dependency-compat/glob"
  }
}
